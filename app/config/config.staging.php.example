define('ENCRYPTION_KEY', 'staging_secure_32_chars________');
define('PASSWORD_SALT', 'staging_salt');
define('SYSTEM_NAME', 'Sistema BDO - Staging');
define('SYSTEM_VERSION', '1.0.0');
define('TIMEZONE', 'America/Sao_Paulo');
define('BASE_URL', 'https://staging.seu-dominio.com');
define('ROOT_PATH', __DIR__ . '/..');
define('SITE_NAME', 'Controller Madeplant');
define('DEBUG_MODE', true);
define('DISPLAY_ERRORS', false);
define('LOG_ERRORS', true);
define('LOG_LEVEL', 'DEBUG');
define('SESSION_NAME', 'BDO_SESSION_STG');
define('SESSION_LIFETIME', 28800);
define('UPLOAD_PATH', ROOT_PATH . '/uploads');
define('MAX_UPLOAD_SIZE', 10485760);
define('ROLE_ADMIN', 1);
define('ROLE_SUPERVISOR', 2);
define('ROLE_LIDER', 3);
define('ROLE_OPERADOR', 4);
define('ROLE_COORD_RH', 5);
define('ROLE_COMPRAS', 6);
date_default_timezone_set(TIMEZONE);
error_reporting(E_ALL);
ini_set('display_errors', 0);
ini_set('log_errors', 1);
@ini_set('error_log', ROOT_PATH . '/logs/php_errors.log');
ini_set('session.name', SESSION_NAME);
ini_set('session.gc_maxlifetime', SESSION_LIFETIME);
ini_set('session.cookie_lifetime', SESSION_LIFETIME);
if (session_status() !== PHP_SESSION_ACTIVE) {
    @session_start();
}
if (is_file(__DIR__ . '/autoload.php')) {
    require_once __DIR__ . '/autoload.php';
}
